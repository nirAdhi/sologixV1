# =====================================================================
#  Sologix website — settings file
# ---------------------------------------------------------------------
#  Copy this file to  .env.docker  (next to docker-compose.yml) and fill
#  in your values. After any change run:
#      docker compose up -d --force-recreate backend
#  NEVER commit .env.docker to git or send it by email/WhatsApp.
#  Lines starting with # are comments. No quotes needed, no spaces around =.
# =====================================================================


# ---------------------------------------------------------------------
#  1. ADMIN LOGIN  (managed here)
# ---------------------------------------------------------------------
# On every restart the admin account below is created/updated to match
# this file: email, password, name, full super-admin rights, active.
# To change the admin password: edit ADMIN_PASSWORD and restart.
# Password rules: 12+ characters, must not start with admin/change/your/password.
ADMIN_EMAIL=admin@sologixenergy.in
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
# true  = this file always wins (recommended)
# false = only used to create the very first admin; later changes are made in the admin panel
ADMIN_SYNC_FROM_ENV=true


# ---------------------------------------------------------------------
#  2. SECURITY KEY  (required — the site will not start without it)
# ---------------------------------------------------------------------
# A long random secret that signs logins. Generate one on the server with:
#     openssl rand -hex 48
# Changing it logs everybody out (they simply log in again).
JWT_SECRET=
JWT_EXPIRE=7d


# ---------------------------------------------------------------------
#  3. EMAIL (SMTP)  — booking confirmations, admin alerts, password resets
# ---------------------------------------------------------------------
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=your full address, SMTP_PASS=an "App password" (Google Account →
#   Security → 2-Step Verification → App passwords), NOT your normal password.
# Hostinger email: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465
# Zoho: SMTP_HOST=smtp.zoho.in, SMTP_PORT=465
# After saving, open Admin → Email & Integrations → "Send test email".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Leave empty: port 465 = SSL/TLS, other ports = STARTTLS. Set true/false only if your provider says so.
SMTP_SECURE=
# Address shown as sender (leave empty to use SMTP_USER; most providers require them to match)
SMTP_FROM=
# Defaults for the admin Email page (can be changed there too)
MAIL_FROM_NAME=Sologix Energy
MAIL_REPLY_TO=info@sologixenergy.in
# Where "new booking / new enquiry / new order" alerts go
ADMIN_NOTIFY_EMAIL=info@sologixenergy.in


# ---------------------------------------------------------------------
#  4. CONTACT DETAILS SHOWN ON THE WEBSITE AND IN EMAILS
# ---------------------------------------------------------------------
BUSINESS_NAME=Sologix Energy
CONTACT_PHONE=+91 8287766474
CONTACT_PHONE_ALT=+91 9031018640
# Number on the floating "Free Consultation" badge (empty = CONTACT_PHONE)
CONSULTATION_PHONE=+91 9771419133
CONTACT_EMAIL=info@sologixenergy.in
CONTACT_EMAIL_ALT=amit@sologixenergy.in
BUSINESS_ADDRESS=STPI Building, Plot-8, Namkum Industrial Area, Ranchi, Jharkhand - 834010
SITE_URL=https://sologixenergy.com
# WhatsApp chat button: number with country code, digits only (91 + 10-digit number)
WHATSAPP_NUMBER=918287766474


# ---------------------------------------------------------------------
#  5. SOCIAL MEDIA BUTTONS  (full https:// links)
# ---------------------------------------------------------------------
# A link set here overrides Admin → Site Content → Social Links.
# Empty = use the link from Admin → Site Content (or the built-in one).
# off   = hide that button everywhere.
# NOTE: both YouTube links that were in the old code return "page not found".
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=https://www.facebook.com/sologix/
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=https://www.linkedin.com/company/m-s-sologix-energy/
SOCIAL_X=


# ---------------------------------------------------------------------
#  6. WHATSAPP BUSINESS API  (optional — powers Admin → WhatsApp inbox)
# ---------------------------------------------------------------------
# From Meta for Developers → your app → WhatsApp → API Setup.
# Not needed for the green WhatsApp chat button (that only uses WHATSAPP_NUMBER).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# App secret (Meta app → Settings → Basic). Required to accept incoming messages.
WHATSAPP_APP_SECRET=
# Any word you choose; enter the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=


# ---------------------------------------------------------------------
#  7. PAYMENTS  (online payment is switched off for now)
# ---------------------------------------------------------------------
UPI_ID=sologixenergy@ybl
UPI_NAME=Sologix Energy
UPI_AMOUNT=2000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
#  8. IMAGE UPLOADS (Cloudinary)  — optional
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---------------------------------------------------------------------
#  9. HUBSPOT CRM  — optional
# ---------------------------------------------------------------------
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=


# ---------------------------------------------------------------------
#  10. DATABASE  — leave as they are unless you know what you are doing
# ---------------------------------------------------------------------
# These are fixed when the database is first created. Changing them here
# later does NOT change the password inside MySQL and will stop the site.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=solar_booking
DB_USER=sologix
DB_PASSWORD=sologix_db_secure_2026
MYSQL_ROOT_PASSWORD=sologix_root_2026


# ---------------------------------------------------------------------
#  11. SERVER  — leave as they are
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://sologixenergy.com,https://www.sologixenergy.com
